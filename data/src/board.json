   "term": "up to 4 years",
   "nominated_by": "The AA Grapevine board.",
   "deadline": {
    "text": "Varies: e.g. Sept 15, 2023; Nov 12, 2025.",
    "fixed": false
   },
   "ref": "R6-H13"
  }
