 "seat_rules": {
  "REG": {
   "label": "Regional trustee",
   "term": "4 one-year terms",
   "nominated_by": "Each area of the region may nominate one candidate (two or more areas may share one), usually chosen by its assembly with the Third Legacy Procedure; résumés are due January 1, and the trustees' Nominating Committee checks eligibility before the Conference. At the Conference a nominating session selects one nominee by Third Legacy Procedure. Its voters are the region's delegates plus an equal number drawn half from the Conference Committee on Trustees and half from the trustees' Nominating Committee. The nominee joins the trustee slate, which stands unless a majority of Conference members disapproves.",
   "deadline": {
    "month_day": "01-01",
    "text": "Résumés due Jan 1 of the election year (postmarked or electronic); GSO announces the openings in a May mailing and Box 4-5-9 the year before.",
    "fixed": true
   },
   "ref": "Service Manual 2026-2028 pp. 54-56, 138 (text L2749, L2788-2790); aa.org notice (June 2, 2026)"
  },
  "TAL_US": {
   "label": "Trustee-at-large/U.S.",
   "term": "4 one-year terms",
   "nominated_by": "U.S. areas send résumés; elected at the Conference (Third Legacy Procedure).",
   "deadline": {
    "month_day": "01-01",
    "text": "Résumés due Jan 1 of the election year (postmarked or electronic); all U.S. areas are notified of the vacancy. Next U.S. elections: 2029, 2033.",
    "fixed": false
   },
   "next_elections": [2029, 2033],
   "ref": "Service Manual 2026-2028 p.55 (text L2789-2790, the Jan 1 deadline), p.57 (text L2887-2888); aa.org notice (June 2, 2026)"
  },
  "TAL_CANADA": {
   "label": "Trustee-at-large/Canada",
   "term": "4 one-year terms",
   "nominated_by": "Canadian areas send résumés; elected at the Conference (Third Legacy Procedure).",
   "deadline": {
    "month_day": "01-01",
    "text": "Résumés due Jan 1 of the election year (postmarked or electronic); all Canadian areas are notified of the vacancy. Next Canada elections: 2027, 2031.",
    "fixed": false
   },
   "next_elections": [2027, 2031],
   "ref": "Service Manual 2026-2028 p.55 (text L2789-2790, the Jan 1 deadline), p.57 (text L2887-2888); aa.org notice (June 2, 2026): résumés for the April 2027 election due Jan 1, 2027"
  },
  "GST": {
   "label": "General service trustee",
   "term": "4 one-year terms",
   "nominated_by": "The corporate board (AAWS or AA Grapevine) proposes one of its current or past nontrustee directors; the trustees' Nominating Committee and the GSB elect.",
   "deadline": null,
   "pattern": "10 of 10 with known history came from the same board; 7 moved up in the year their director term ended, 2 mid-term (Grapevine 2023, 2025), 1 a past director.",
   "ref": "R6-H7 (2017-2026 rosters); FR25 p109 L9978-9983"
  },
  "CLASS_A": {
   "label": "Class A (nonalcoholic) trustee",
   "term": "up to two 3-year terms (6 years); the GSB chair serves 4 years over and above",
   "nominated_by": "The trustees' Nominating Committee searches (an aa.org call) and interviews candidates; elected by the GSB at the annual meeting.",
   "deadline": {
    "text": "Not fixed: e.g. letter Nov 6, 2023 with a Dec 14, 2023 deadline (2024 seat); later calls about June with an Aug 31 deadline.",
    "fixed": false
   },
   "ref": "Service Manual 2026-2028 (text L2686-2688); FR26 p108 L10081-10088"
  },
  "GSB_CHAIR": {
   "label": "General Service Board chair",
   "term": "4 years (Class A or Class B; a Class B chair adds a 22nd seat)",
   "nominated_by": "The trustees' Nominating Committee; elected by the GSB.",
   "ref": "Service Manual 2026-2028 p. 58; GSB bylaws (Appendix O) pp. 137, 139-140"
  },
  "DIR_AAWS": {
   "label": "AAWS nontrustee director",
   "term": "up to 4 years",
   "nominated_by": "The AAWS board (call via Box 4-5-9 and a mailing); past delegates may apply one year after their last Conference.",
   "deadline": {
    "text": "Varies: e.g. notice May 6, 2025 with a Jul 1, 2025 deadline.",
